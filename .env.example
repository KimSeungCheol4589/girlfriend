# 환경 변수 예시 — 실제 값은 넣지 않는다 (DESIGN.md 11)
#
# 이 파일은 "이름과 형식"만 보여 준다. 실제 키는 배포 환경 설정이나 Git에서 제외한
# .env.local 에 둔다. 아래 값은 모두 자리표시자이며 그대로 쓰면 앱은 "설정 필요" 화면을 보여 준다.
#
# 사용법
#   cp .env.example .env.local   # 그리고 자리표시자를 실제 값으로 바꾼다
#
# 브라우저로 전달되는 값은 NEXT_PUBLIC_ 접두사가 붙은 두 개뿐이다.
# 관리자 키(service_role)는 앱의 일반 요청 경로에서 사용하지 않는다. 아래 설명을 참고한다.

# ---------------------------------------------------------------------------
# 1) 앱(브라우저·서버 공통)
# ---------------------------------------------------------------------------

# Supabase API 주소. 로컬 개발 환경 예: http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_URL

# 공개용 키. Supabase 대시보드의 publishable key(구 anon key)를 넣는다.
# 이 값은 브라우저에 전달되며 RLS가 실제 접근을 제한한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY

# 구버전 이름도 읽는다(둘 중 하나만 있으면 된다).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# 인증 메일 링크가 돌아올 앱 주소. 비우면 요청의 Origin을 사용한다.
# 배포 환경에서는 실제 주소를 명시해 열린 리다이렉트를 막는다. 예: https://example.com
# NEXT_PUBLIC_SITE_URL=

# 데모 모드. 'true'로 **명시적으로 켰을 때만** 데모 화면이 동작한다.
# 값이 없거나 다른 값이면 데모는 꺼져 있다. 이때 위 Supabase 설정이 없으면
# 앱은 "설정 필요" 화면으로 분명히 실패한다(데모로 대체하지 않는다).
# 데모 화면 확인·데모 E2E·HTTP smoke를 실행할 때만 true로 둔다. 운영 환경에서는 설정하지 않는다.
# NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# 2) 로컬 인증 E2E 픽스처 전용 (앱은 읽지 않는다)
# ---------------------------------------------------------------------------
# tests/auth/fixtures/* 가 로컬 Supabase에 합성 계정을 만들 때만 사용한다.
# 앱 코드와 브라우저 번들은 이 값을 참조하지 않는다. 운영 키를 넣지 않는다.
#
# 관리자 키. 로컬 테스트 인스턴스의 service_role 키만 넣는다.
# AUTH_TEST_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY
#
# 최초 공간 생성 허용 목록(app_private.bootstrap_creators) 등록에 쓰는 로컬 DB 컨테이너 이름.
# 지정하지 않으면 픽스처가 등록 SQL을 안내만 하고 실행하지 않는다.
# AUTH_TEST_DB_CONTAINER=
#
# 픽스처가 만드는 합성 계정 접두사. 도메인은 항상 .invalid 이며 변경할 수 없다.
# 계정 A(공간 생성) · B(초대 대상) · C(외부) · D(비밀번호 재설정 전용) 네 개를 만든다.
# AUTH_TEST_EMAIL_PREFIX=auth-e2e
