# Local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build outputs
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Dev Container는 pnpm store를 컨테이너 볼륨에 두지만, lifecycle이 중간에 실패해
# store 설정이 기록되지 않으면 pnpm이 작업 폴더 안에 store를 만든다.
# 그 잔여물이 커밋되지 않도록 방어적으로 무시한다.
/.pnpm-store/

# Generated by Next.js on dev/build. Not edited by hand.
next-env.d.ts

# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local deployment settings and logs
.vercel/
*.log

# OS metadata
.DS_Store
Thumbs.db

# Local agent prompts, transcripts and process state
.agent-runtime/
